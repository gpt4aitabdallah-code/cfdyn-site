RewriteEngine On
# Force HTTPS et domaine canonique cfdyn.com
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.cfdyn\.com$ [NC]
RewriteRule ^(.*)$ https://cfdyn.com/$1 [R=301,L]
# Cache statique
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
AddDefaultCharset UTF-8
